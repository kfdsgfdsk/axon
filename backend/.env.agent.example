# AXON agent env — copy to `.env.agent` and fill in your key.
#
#   cp backend/.env.agent.example backend/.env.agent
#   # edit MUSE_API_KEY, then:
#   ./docker-start.sh down && ./docker-start.sh up
#
# NEVER commit `.env.agent` (gitignored). Without a key the desk still runs:
# routing falls back to deterministic rules and crews run in degraded mode.

# --- Meta Muse credentials (REQUIRED for full AI desk) ---
# Your Meta Model API key. Create one at https://developers.meta.com
MUSE_API_KEY=paste-your-meta-model-api-key-here
MUSE_BASE_URL=https://api.meta.ai/v1

# --- Model selection (sane defaults; override only if you know why) ---
# Crew models: gathering roles use the fast tier, judgment roles the strong tier.
MUSE_MODEL=muse-spark-1.3
MUSE_FAST_MODEL=muse-spark-1.3
# Optional third tier for deep reasoning (strategist/judge on deep runs).
# AGENT_DEEP_MODEL=muse-wonder-1.0
# Reasoning effort for deep roles: minimal | low | medium | high | xhigh | max
# AGENT_REASONING_EFFORT=high

# --- Timeouts ---
# Per-attempt model HTTP timeout (ms).
# MUSE_TIMEOUT_MS=60000
# Whole-crew wall-clock deadline (ms).
# AGENT_CREW_DEADLINE_MS=120000

# --- Behavior switches ---
# Demo book: true = seeded balances (judge-friendly), false = live data, auto = per-request.
AGENT_DEMO_MODE=auto
# AI-first intent routing (false = deterministic rules only).
# AGENT_CAPABILITY_AI=true
