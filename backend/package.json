{
  "name": "crypto-exchange-api",
  "version": "1.0.0",
  "description": "Secure centralized crypto exchange API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' nodemon src/server.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "job:deposit-scanner": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node src/jobs/depositScanner.job.ts",
    "crew:live": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node --transpile-only scripts/crew-live-scenarios.ts",
    "wallet:init": "ts-node src/scripts/initMasterWallet.ts",
    "tokens:seed": "ts-node src/scripts/seedTokens.ts",
    "job:trade-monitor": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node src/jobs/tradeMonitor.job.ts",
    "worker:dev": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node src/worker-entry.ts",
    "worker:start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/worker-entry.js",
    "signer:dev": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node src/signer-entry.ts",
    "signer:start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/signer-entry.js",
    "agent:dev": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node src/agent-entry.ts",
    "agent:start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/agent-entry.js",
    "approval:dev": "NODE_OPTIONS='--dns-result-order=ipv4first' ts-node src/approval-entry.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@scure/bip32": "^1.6.0",
    "@scure/bip39": "^1.5.0",
    "@solana/web3.js": "^1.99.0",
    "bcryptjs": "^2.4.3",
    "bitcoinjs-lib": "^6.1.7",
    "bs58": "^6.0.0",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ecpair": "^2.1.0",
    "ethers": "^6.13.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^6.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.14.2",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.4",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "prisma": "^6.5.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
